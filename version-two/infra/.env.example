# ============================================================================
# Version 2.0 Local Developer Environment Configuration (.env.example)
# Copy to .env and customize locally. ZERO production secrets are committed here.
# ============================================================================

# 1. DuckLake Catalog Database (Local PostgreSQL on Port 5433)
POSTGRES_DB=ducklake_catalog
POSTGRES_USER=ducklake_dev
POSTGRES_PASSWORD=<replace-with-local-dev-password>
DUCKLAKE_DB_URL=postgresql://ducklake_dev:<replace-with-local-dev-password>@127.0.0.1:5433/ducklake_catalog

# 2. Google Cloud Storage & Application Default Credentials (ADC)
# Authenticate via: gcloud auth application-default login
GCS_BUCKET_NAME=scbi-ducklake-myanalyticsproduct
GCP_PROJECT_ID=myanalyticsproduct

# 3. Cube.js 1.7.x Semantic Layer Configuration
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=<replace-with-local-hs256-jwt-secret>
CUBE_REST_PORT=4000
CUBE_SQL_PORT=5432

# 4. Thin Web Portal API Gateway
PORTAL_PORT=8000
PORTAL_DEFAULT_DEV_EMAIL=charltonsmithfde@gmail.com
