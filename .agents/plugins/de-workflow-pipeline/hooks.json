{
  "kanban-auto-sync": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/sync_kanban.py",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "ship-gate-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/gate_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "workflow-stop-check": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_workflow_state.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}